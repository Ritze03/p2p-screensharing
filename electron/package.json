{
  "name": "p2p-screensharing",
  "private": true,
  "version": "0.1.0",
  "description": "Serverless P2P screensharing (Electron shell; media over Chromium-native WebRTC).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:appimage": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "net.p2pscreensharing.app",
    "productName": "p2p-screensharing",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "../frontend", "to": "frontend" }
    ],
    "linux": {
      "target": ["AppImage"],
      "icon": "../frontend/assets/icons/mark-256.png",
      "category": "Network"
    }
  }
}
